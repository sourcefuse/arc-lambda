{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/cdk"
  ],
  "scripts": {
    "prepare": "husky install && node create-env.js"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "overrides": {
    "basic-ftp": "^6.2.4",
    "@xmldom/xmldom": "^0.8.15",
    "underscore": "^1.13.8",
    "lodash": "^4.18.1",
    "request": {
      "form-data": "^2.5.6"
    },
    "axios": "^0.35.0",
    "js-yaml": "^4.3.2",
    "minimatch": "^3.1.4",
    "@node-saml/node-saml": "^5.1.0",
    "@node-saml/passport-saml": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "tar": "^7.5.21",
    "undici": "^6.29.1",
    "msgpack5": "^6.1.0",
    "fast-xml-parser": "^4.5.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.0.0",
    "glob": "^10.3.3",
    "husky": "^8.0.3",
    "lerna": "^7.1.5"
  }
